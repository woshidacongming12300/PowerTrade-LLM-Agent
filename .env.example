# ============================================================
# Electricity Price Intelligence — environment configuration
# Copy to .env and fill in real values.  (.env is git-ignored.)
# ============================================================

# DashScope (Alibaba Cloud Model Studio) API Key — https://bailian.console.aliyun.com
# Required: used for chat (qwen3.x via OpenAI-compatible endpoint) + embeddings.
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Optional FastAPI auth: if set, /api/* requests need header `X-API-Key: <key>`.
# Leave empty for local development.
API_KEY=

# EIA API Key — register at https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key_here

# Enable real-time MISO market data (requires non-China network).
GRIDSTATUS_ENABLED=0

# --- Chainlit conversation-history auth ---
CHAINLIT_AUTH_SECRET=change-me-to-a-random-secret
CHAINLIT_AUTH_PASSWORD=epf2026

# --- Optional: Langfuse observability backend --------------------------------
# When LANGFUSE_PUBLIC_KEY + LANGFUSE_SECRET_KEY are set (and `langfuse` is
# installed), the trace layer switches from local trace.jsonl to Langfuse.
# Self-host via: docker run -p 3000:3000 langfuse/langfuse (see docker-compose).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- Optional: Chroma persist dir override ------------------------------------
# Set if the project path contains non-ASCII characters (Windows Chroma/HNSW
# persistence can fail) — otherwise auto-fallback to %LOCALAPPDATA%.
# AGENT_CHROMA_PERSIST_DIR=C:/agent_chroma_persist

# --- Optional: server deployment (sync script) ---
SERVER_PASSWORD=
