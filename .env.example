# EIA API Key — register at https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key_here

# DashScope API Key — get from https://dashscope.aliyun.com
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Server deployment (optional, for sync script)
SERVER_PASSWORD=your_server_password

# Chainlit auth (optional, for conversation history)
CHAINLIT_AUTH_SECRET=your_random_secret
CHAINLIT_AUTH_PASSWORD=epf2026

# Enable real-time MISO data (requires non-China network)
GRIDSTATUS_ENABLED=0
